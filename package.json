{
  "name": "pi-scheduler",
  "version": "0.3.2",
  "description": "Simple scheduled loop/reminder extension for pi",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "scheduler",
    "loop",
    "cron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojlds/pi-scheduler.git"
  },
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "croner": "^9.1.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.20.6",
    "typebox": "~1.3.27",
    "typescript": "^5.8.2"
  }
}
